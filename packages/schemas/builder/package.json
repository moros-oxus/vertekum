    ".": "./src/index.ts",
    "./api": "./src/api.ts",
    "./cli": "./src/cli.ts"
  },
  "peerDependencies": {
    "@vertekum/core": "workspace:*"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vertekum/core": "workspace:*",
    "@vertekum/schema-vocabulary": "workspace:*"
  }
}
