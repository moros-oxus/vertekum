  "license": "MIT",
  "keywords": [
    "design-tokens",
    "dtcg",
    "schema",
    "w3c"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moros-oxus/vertekum.git",
    "directory": "packages/schemas/dtcg"
  },
  "homepage": "https://github.com/moros-oxus/vertekum",
  "bugs": "https://github.com/moros-oxus/vertekum/issues",
  "files": [
    "CHANGELOG.md",
    "format.json",
    "resolver.json",
    "template"
  ],
  "publishConfig": {
