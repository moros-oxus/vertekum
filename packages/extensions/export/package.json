{
  "name": "@vertekum/ext-export",
  "version": "0.1.0",
  "description": "Vertekum extension: export tokens to output targets (CSS variables…)",
  "license": "UNLICENSED",
  "private": true,
  "files": [
    "src",
    "tsconfig.json",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts",
    "./ui": "./src/ui.tsx"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "vertekum": "workspace:*"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "vertekum": "workspace:*"
  }
}
