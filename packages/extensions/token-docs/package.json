{
  "name": "@vertekum/ext-token-docs",
  "version": "0.5.0",
  "description": "Vertekum extension: notes on tokens and groups — documentation, agent guidance, MCP — stored in $extensions and readable by any consumer",
  "license": "Apache-2.0",
  "keywords": [
    "design-tokens",
    "dtcg",
    "documentation",
    "annotations",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moros-oxus/vertekum.git",
    "directory": "packages/extensions/token-docs"
  },
  "homepage": "https://github.com/moros-oxus/vertekum",
  "bugs": "https://github.com/moros-oxus/vertekum/issues",
  "files": [
    "CHANGELOG.md",
    "docs",
    "src",
    "tsconfig.json",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts"
  },
  "peerDependencies": {
    "@vertekum/core": "workspace:*"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vertekum/core": "workspace:*"
  }
}
