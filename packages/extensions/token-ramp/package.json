{
  "name": "@vertekum/ext-token-ramp",
  "version": "0.3.13",
  "description": "Vertekum extension: generate colour ramps from a single brand anchor — a fixed lightness ladder with chroma arched through the anchor",
  "license": "Apache-2.0",
  "keywords": [
    "design-tokens",
    "dtcg",
    "color",
    "ramp",
    "palette"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moros-oxus/vertekum.git",
    "directory": "packages/extensions/token-ramp"
  },
  "homepage": "https://github.com/moros-oxus/vertekum",
  "bugs": "https://github.com/moros-oxus/vertekum/issues",
  "files": [
    "CHANGELOG.md",
    "docs",
    "src",
    "tsconfig.json",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/index.ts",
