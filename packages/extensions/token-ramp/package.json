  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts"
  },
  "peerDependencies": {
    "@vertekum/core": "workspace:*"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@vertekum/core": "workspace:*"
  }
}
