{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vertekum:figma-model/draft.06",
  "title": "Figma-shaped model",
  "description": "A resolved view of one or more compositions in Figma's vocabulary: collections with modes, variables with per-mode values and alias edges, and styles. Version draft.06 — the version names this contract shape, not the tokens a document holds.",
  "type": "object",
  "required": ["version", "source", "collections", "styles"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "draft.06" },
    "source": {
      "type": "object",
      "required": ["compositions", "generator", "notices"],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string" },
        "compositions": { "type": "array", "items": { "type": "string" } },
        "generator": { "type": "string" },
        "notices": { "type": "array", "items": { "type": "string" } },
        "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "notAvailable": {
          "type": "object",
          "required": ["collection", "variables"],
          "additionalProperties": false,
          "properties": {
            "collection": { "type": "string" },
            "variables": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "COLOR": { "type": "string" },
                "FLOAT": { "type": "string" },
                "STRING": { "type": "string" },
                "BOOLEAN": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "modes", "variables"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "modes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "variables": {
            "type": "array",
            "items": { "$ref": "#/$defs/variable" }
          },
          "modeSources": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["composition"],
              "additionalProperties": false,
              "properties": {
                "composition": { "type": "string", "minLength": 1 },
                "context": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "styles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "name", "properties", "source"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["text", "effect"] },
          "name": { "type": "string", "minLength": 1 },
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["property", "value"],
              "additionalProperties": false,
              "properties": {
                "property": { "type": "string" },
                "value": {
                  "description": "The plain value. A text style's line-height is a px string (\"68px\") when its variable holds the token translated to px, and a unitless multiplier otherwise."
                },
                "variable": {
                  "type": "string",
                  "description": "The variable this member references (it exists in the model). A design tool binds it when the property takes that variable's type; letter-spacing and line-height bind only when the value is px."
                }
              }
            }
          },
          "source": { "$ref": "#/$defs/source" },
          "deprecated": {
            "type": "string",
            "description": "DTCG $deprecated: the reason, or \"\" when none was given. Absent = not deprecated."
          }
        }
      }
    }
  },
  "$defs": {
    "variable": {
      "type": "object",
      "required": ["name", "type", "valuesByMode", "scopes", "codeSyntax"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["COLOR", "FLOAT", "STRING", "BOOLEAN"] },
        "valuesByMode": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "number" },
              { "type": "string" },
              { "type": "boolean" },
              {
                "type": "object",
                "required": ["r", "g", "b", "a"],
                "additionalProperties": false,
                "properties": {
                  "r": { "type": "number" },
                  "g": { "type": "number" },
                  "b": { "type": "number" },
                  "a": { "type": "number" }
                }
              }
            ]
          }
        },
        "alias": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "source": { "$ref": "#/$defs/source" },
        "deprecated": {
          "type": "string",
          "description": "DTCG $deprecated: the reason, or \"\" when none was given. Absent = not deprecated."
        },
        "sources": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "codeSyntax": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["$type", "$value"],
      "additionalProperties": false,
      "properties": {
        "$type": { "type": "string" },
        "$value": {}
      }
    }
  }
}
