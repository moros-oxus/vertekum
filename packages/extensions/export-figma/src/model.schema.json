{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vertekum:figma-model/draft.02",
  "title": "Figma-shaped model",
  "description": "A resolved view of one or more compositions in Figma's vocabulary: collections with modes, variables with per-mode values and alias edges, and styles. Version draft.02 — the version names this contract shape, not the tokens a document holds.",
  "type": "object",
  "required": ["version", "source", "collections", "styles"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "draft.02" },
    "source": {
      "type": "object",
      "required": ["compositions", "generator", "notices"],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string" },
        "compositions": { "type": "array", "items": { "type": "string" } },
        "generator": { "type": "string" },
        "notices": { "type": "array", "items": { "type": "string" } }
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "modes", "variables"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "modes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "variables": {
            "type": "array",
            "items": { "$ref": "#/$defs/variable" }
          },
          "modeSources": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["composition"],
              "additionalProperties": false,
              "properties": {
                "composition": { "type": "string", "minLength": 1 },
                "context": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "styles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "name", "properties", "source"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["text", "effect"] },
          "name": { "type": "string", "minLength": 1 },
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["property", "value"],
              "additionalProperties": false,
              "properties": {
                "property": { "type": "string" },
                "value": {},
                "variable": { "type": "string" }
              }
            }
          },
          "source": { "$ref": "#/$defs/source" }
        }
      }
    }
  },
  "$defs": {
    "variable": {
      "type": "object",
      "required": ["name", "type", "valuesByMode", "scopes", "codeSyntax"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["COLOR", "FLOAT", "STRING", "BOOLEAN"] },
        "valuesByMode": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "number" },
              { "type": "string" },
              { "type": "boolean" },
              {
                "type": "object",
                "required": ["r", "g", "b", "a"],
                "additionalProperties": false,
                "properties": {
                  "r": { "type": "number" },
                  "g": { "type": "number" },
                  "b": { "type": "number" },
                  "a": { "type": "number" }
                }
              }
            ]
          }
        },
        "alias": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "source": { "$ref": "#/$defs/source" },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "codeSyntax": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["$type", "$value"],
      "additionalProperties": false,
      "properties": {
        "$type": { "type": "string" },
        "$value": {}
      }
    }
  }
}
